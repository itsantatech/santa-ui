# Public URL of this Next.js application. Used for OAuth callbacks, cookies, and SEO metadata.
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Keycloak OpenID Connect configuration.
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=santa-web
KEYCLOAK_CLIENT_ID=santa-ui

# Required only when the Keycloak client is confidential. Store the real value in a secret manager.
KEYCLOAK_CLIENT_SECRET=

# Server-side URL of the Santa API.
SANTA_API_BASE_URL=http://localhost:4000

# Optional browser-visible fallbacks. Prefer the server-side variables above where possible.
# NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000
# NEXT_PUBLIC_KEYCLOAK_BASE_URL=http://localhost:8080
# NEXT_PUBLIC_SANTA_API_BASE_URL=http://localhost:4000
